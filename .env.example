SPOTIFY_CLIENT_ID=
LOCALTIFY_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/PUT_YOUR_WEBHOOK_HERE
# Optional licensed TheAudioDB key for packaged builds; free key 123 is development-only.
LOCALTIFY_AUDIODB_API_KEY=
# Last.fm 32-character APPLICATION API key (not your Last.fm shared secret).
# In development Electron reads .env only in the main process. Packaged builds
# include this optional PUBLIC app key from the packager's environment; do not
# treat keys shipped to end-user desktops as confidential. Use a server proxy
# for any credential that must remain private.
LOCALTIFY_LASTFM_API_KEY=
